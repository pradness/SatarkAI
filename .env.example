# MongoDB Connection
MONGODB_URI=mongodb://127.0.0.1:27017/satarkai_db
MONGODB_DATABASE=satarkai_db

# Speech-to-Text Whisper Configuration
# Options:
#   Oriserve/Whisper-Hindi2Hinglish-Apex (Default: fine-tuned for Hinglish)
#   openai/whisper-tiny                 (Ultra-fast for CPU: 39M params, ~0.2s latency)
#   openai/whisper-base                 (Fast for CPU: 74M params, ~0.5s latency)
WHISPER_MODEL_ID=Oriserve/Whisper-Hindi2Hinglish-Apex
WHISPER_MAX_NEW_TOKENS=48
WHISPER_INT8_CPU=true

# Vishing Scam Classification Model (IndicBERT)
MODEL_PATH=suyog17/indica-vishing-model

# JWT & Authentication for Investigation Dashboard
JWT_SECRET_KEY=satarkai_cyber_investigation_jwt_secret_key_2026_spit
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
