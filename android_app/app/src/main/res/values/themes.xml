<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SatarkAI" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/satark_bg</item>
        <item name="android:statusBarColor">@color/satark_card</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/satark_card</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!-- Brand Colors -->
        <item name="colorPrimary">@color/satark_teal</item>
        <item name="colorPrimaryDark">@color/satark_teal_dark</item>
        <item name="colorOnPrimary">@color/satark_btn_primary_text</item>
        <item name="colorSecondary">@color/satark_teal</item>
        <item name="colorOnSecondary">@color/satark_btn_primary_text</item>
        <item name="colorAccent">@color/satark_teal</item>

        <!-- Typography & Clean Font Rendering -->
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColorPrimary">@color/satark_text_primary</item>
        <item name="android:textColorSecondary">@color/satark_text_secondary</item>
        <item name="android:editTextColor">@color/satark_text_primary</item>

        <!-- Button Defaults (No all-caps forced) -->
        <item name="textAllCaps">false</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Theme for Fullscreen In-Call Experience -->
    <style name="Theme.SatarkAI.Calling" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/satark_call_screen_bg</item>
        <item name="android:statusBarColor">@color/satark_call_screen_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/satark_call_screen_bg</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="colorPrimary">@color/satark_teal</item>
        <item name="colorOnPrimary">@color/satark_white</item>
        <item name="colorAccent">@color/satark_teal</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColorPrimary">@color/satark_white</item>
        <item name="android:textColorSecondary">@color/satark_text_muted</item>
        <item name="textAllCaps">false</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
