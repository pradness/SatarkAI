<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material 3 Dark Theme with fixed security palette (compatible with Android 11 and lower) -->
    <style name="Theme.SatarkAI" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- System Bar Controls -->
        <item name="android:windowBackground">@color/satark_bg</item>
        <item name="android:statusBarColor">@color/satark_card</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/satark_card</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- Material 3 Color Roles (Dark Mode Teal / Dark Slate) -->
        <item name="colorPrimary">@color/satark_teal</item>
        <item name="colorOnPrimary">@color/satark_btn_primary_text</item>
        <item name="colorPrimaryContainer">@color/satark_teal_soft</item>
        <item name="colorOnPrimaryContainer">@color/satark_teal_light</item>

        <item name="colorSecondary">@color/satark_navy_light</item>
        <item name="colorOnSecondary">@color/satark_white</item>
        <item name="colorSecondaryContainer">@color/satark_card_alt</item>
        <item name="colorOnSecondaryContainer">@color/satark_navy</item>

        <item name="colorSurface">@color/satark_card</item>
        <item name="colorOnSurface">@color/satark_text_primary</item>
        <item name="colorSurfaceVariant">@color/satark_card_alt</item>
        <item name="colorOnSurfaceVariant">@color/satark_text_secondary</item>
        <item name="colorOutline">@color/satark_border</item>
        <item name="colorOutlineVariant">@color/satark_divider</item>

        <item name="colorError">@color/satark_scam_red</item>
        <item name="colorOnError">@color/satark_white</item>
        <item name="colorErrorContainer">@color/satark_scam_red_bg</item>
        <item name="colorOnErrorContainer">@color/satark_scam_banner_text</item>

        <!-- Legacy attributes -->
        <item name="colorPrimaryDark">@color/satark_teal_dark</item>
        <item name="colorAccent">@color/satark_teal</item>

        <!-- Typography & Clean Font Rendering -->
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColorPrimary">@color/satark_text_primary</item>
        <item name="android:textColorSecondary">@color/satark_text_secondary</item>
        <item name="android:editTextColor">@color/satark_text_primary</item>

        <!-- Material 3 Shape & Elevation defaults -->
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.SatarkAI.SmallComponent</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.SatarkAI.MediumComponent</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.SatarkAI.LargeComponent</item>

        <!-- Button Defaults -->
        <item name="textAllCaps">false</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
