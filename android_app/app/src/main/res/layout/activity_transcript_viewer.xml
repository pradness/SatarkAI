<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/satark_bg"
    android:orientation="vertical">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/satark_card"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageButton
            android:id="@+id/buttonBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_back"
            app:tint="@color/satark_icon_normal" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Call Evidence Transcript"
                android:textColor="@color/satark_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textTranscriptSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Session: call_sess_9011 • Forensic Record"
                android:textColor="@color/satark_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/textHeaderThreatBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_scam"
            android:paddingLeft="10dp"
            android:paddingTop="5dp"
            android:paddingRight="10dp"
            android:paddingBottom="5dp"
            android:text="SCAM (94%)"
            android:textColor="@color/satark_scam_red"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Evidence Summary Card -->
            <LinearLayout
                android:id="@+id/cardEvidenceSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_scam_warning_box"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/imageThreatStatusIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="Threat Status"
                        android:src="@drawable/ic_shield_alert"
                        app:tint="@color/satark_scam_red" />

                    <TextView
                        android:id="@+id/textThreatBannerTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="VISHING THREAT CONFIRMED"
                        android:textColor="@color/satark_scam_red"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textThreatSummaryDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="2dp"
                    android:text="Impersonation of banking authority attempting urgent OTP theft. High risk indicators highlighted below in red."
                    android:textColor="@color/satark_scam_banner_text"
                    android:textSize="13sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:background="@color/satark_scam_banner_border" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/textEvidenceCaller"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Caller: Unknown (+91 98765 43210)"
                        android:textColor="@color/satark_text_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textEvidenceTiming"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Today, 02:45 PM (1m 32s)"
                        android:textColor="@color/satark_text_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutReportAction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Minimal text + Material Icon button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonReportCall"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:backgroundTint="@color/satark_btn_danger_bg"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:text="Report Scam"
                        android:textAllCaps="false"
                        android:textColor="@color/satark_btn_danger_text"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:cornerRadius="8dp"
                        app:icon="@drawable/ic_flag"
                        app:iconGravity="textStart"
                        app:iconPadding="6dp"
                        app:iconSize="16dp"
                        app:iconTint="@color/satark_btn_danger_text" />

                    <TextView
                        android:id="@+id/textReportStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="Flag suspicious call for Cyber Investigation review"
                        android:textColor="@color/satark_text_muted"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="12dp"
                android:text="LIVE CONVERSATION RECORD"
                android:textColor="@color/satark_text_muted"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Container for Chat Bubbles -->
            <LinearLayout
                android:id="@+id/layoutTranscriptBubbles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>

    <!-- Footer Notice -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/satark_card"
        android:elevation="2dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Verified Evidence • Analyzed by SatarkAI IndicBERT"
            android:textColor="@color/satark_text_muted"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
