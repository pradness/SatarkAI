<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card_white"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <!-- Direction icon with round badge -->
    <ImageView
        android:id="@+id/imageCallDirection"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_panel_soft"
        android:contentDescription="Call Direction"
        android:padding="10dp"
        android:src="@drawable/ic_call_incoming"
        app:tint="@color/satark_teal" />

    <!-- Details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textHistoryContactName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Unknown (+91 98765 43210)"
            android:textColor="@color/satark_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textHistoryMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Today, 02:45 PM • 1m 32s"
            android:textColor="@color/satark_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Security Status Badge & Transcript hint -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textSecurityBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_scam"
            android:paddingLeft="10dp"
            android:paddingTop="4dp"
            android:paddingRight="10dp"
            android:paddingBottom="4dp"
            android:text="SCAM DETECTED"
            android:textColor="@color/satark_scam_red"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textTranscriptHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Transcript"
            android:textColor="@color/satark_teal"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
