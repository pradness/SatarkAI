<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootCallingLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/satark_call_screen_bg"
    android:padding="20dp">

    <!-- Top Status Bar & Simulation controls -->
    <LinearLayout
        android:id="@+id/layoutTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Security Threat Badge -->
        <TextView
            android:id="@+id/textStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip"
            android:paddingLeft="14dp"
            android:paddingTop="8dp"
            android:paddingRight="14dp"
            android:paddingBottom="8dp"
            android:text="Protected by SatarkAI"
            android:textColor="@color/satark_teal"
            android:textSize="12sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Mock / Simulation Toggle Pills for Testing Scam Detection UI -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSimulateSafe"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:backgroundTint="@color/satark_safe_bg"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                app:strokeColor="@color/satark_safe_border"
                app:strokeWidth="1dp"
                android:text="Safe"
                android:textAllCaps="false"
                android:textColor="@color/satark_safe_text"
                android:textSize="11sp"
                android:textStyle="bold"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_shield_check"
                app:iconGravity="textStart"
                app:iconPadding="4dp"
                app:iconSize="14dp"
                app:iconTint="@color/satark_safe_text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSimulateScam"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:backgroundTint="@color/satark_scam_red_bg"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                app:strokeColor="@color/satark_scam_border"
                app:strokeWidth="1dp"
                android:text="Scam"
                android:textAllCaps="false"
                android:textColor="@color/satark_scam_red"
                android:textSize="11sp"
                android:textStyle="bold"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_shield_alert"
                app:iconGravity="textStart"
                app:iconPadding="4dp"
                app:iconSize="14dp"
                app:iconTint="@color/satark_scam_red" />
        </LinearLayout>
    </LinearLayout>

    <!-- Scrollable Central Content (Caller Info, Scam Alert, Live Transcripts) -->
    <ScrollView
        android:id="@+id/scrollCallingContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/layoutBottomControls"
        android:layout_below="@+id/layoutTopBar"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- Caller Avatar -->
            <TextView
                android:id="@+id/textCallerAvatar"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_avatar_circle"
                android:gravity="center"
                android:text="SB"
                android:textColor="@color/satark_white"
                android:textSize="32sp"
                android:textStyle="bold" />

            <!-- Caller Name -->
            <TextView
                android:id="@+id/textRemoteParty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="State Bank of India (Official)"
                android:textColor="@color/satark_white"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- Call Timer / State Subtitle -->
            <TextView
                android:id="@+id/textCallTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="00:48 • Active VoIP Session"
                android:textColor="@color/satark_teal_light"
                android:textSize="14sp" />

            <!-- SCAM DETECTED Banner Box (Transitions in when scam is identified) -->
            <LinearLayout
                android:id="@+id/layoutScamWarningCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_scam_warning_box"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="Scam alert"
                        android:src="@drawable/ic_shield_alert"
                        app:tint="@color/satark_scam_red" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="SCAM DETECTED"
                        android:textColor="@color/satark_scam_red"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textScamWarningReason"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="2dp"
                    android:text="Caller is asking for a 6-digit OTP under false pretexts. Do not share codes. Hang up immediately."
                    android:textColor="@color/satark_scam_banner_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textConfidenceScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_badge_scam"
                    android:paddingLeft="8dp"
                    android:paddingTop="3dp"
                    android:paddingRight="8dp"
                    android:paddingBottom="3dp"
                    android:text="Threat Confidence: 94% • High Risk Vishing"
                    android:textColor="@color/satark_scam_red"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- View Live Transcript Toggle Button (Minimal text + Material Icon) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonToggleLiveTranscript"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="#1AFFFFFF"
                app:strokeColor="@color/satark_teal"
                app:strokeWidth="1.5dp"
                android:text="Transcript"
                android:textAllCaps="false"
                android:textColor="@color/satark_teal"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="21dp"
                app:icon="@drawable/ic_transcript"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconSize="18dp"
                app:iconTint="@color/satark_teal" />

            <!-- WhatsApp-Style Live Dual-Speaker Transcript Panel (Hidden by default!) -->
            <LinearLayout
                android:id="@+id/layoutLiveTranscriptPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_panel_soft"
                android:orientation="vertical"
                android:padding="14dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="LIVE CALL TRANSCRIPT"
                    android:textColor="@color/satark_text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- Container where live chat bubbles are added -->
                <LinearLayout
                    android:id="@+id/layoutLiveBubblesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Controls: Large intuitive calling buttons -->
    <LinearLayout
        android:id="@+id/layoutBottomControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingBottom="12dp">

        <!-- Incoming Call Decision (Accept / Reject) -->
        <LinearLayout
            android:id="@+id/layoutIncomingDecision"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/buttonReject"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_button_end_call"
                    android:contentDescription="Reject Call"
                    android:padding="18dp"
                    android:src="@drawable/ic_phone_end"
                    app:tint="@color/satark_white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Decline"
                    android:textColor="@color/satark_white"
                    android:textSize="13sp" />
            </LinearLayout>

            <View
                android:layout_width="60dp"
                android:layout_height="1dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/buttonAccept"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_button_accept_call"
                    android:contentDescription="Accept Call"
                    android:padding="18dp"
                    android:src="@drawable/ic_phone"
                    app:tint="@color/satark_white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Accept"
                    android:textColor="@color/satark_white"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Active Call Controls: Speaker, End Call, Mute -->
        <LinearLayout
            android:id="@+id/layoutActiveControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- Mute Toggle -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/buttonMute"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_button_control"
                    android:contentDescription="Mute"
                    android:padding="14dp"
                    android:src="@drawable/ic_mic_mute"
                    app:tint="@color/satark_white" />

                <TextView
                    android:id="@+id/textMuteLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Mute"
                    android:textColor="@color/satark_text_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- End Call (Large prominent red button) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="36dp"
                android:layout_marginEnd="36dp"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/buttonHangup"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_button_end_call"
                    android:contentDescription="End Call"
                    android:padding="18dp"
                    android:src="@drawable/ic_phone_end"
                    app:tint="@color/satark_white" />

                <TextView
                    android:id="@+id/textHangupLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="End"
                    android:textColor="@color/satark_white"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Speaker Toggle -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/buttonSpeaker"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_button_control"
                    android:contentDescription="Speaker"
                    android:padding="14dp"
                    android:src="@drawable/ic_speaker"
                    app:tint="@color/satark_white" />

                <TextView
                    android:id="@+id/textSpeakerLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Speaker"
                    android:textColor="@color/satark_text_muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
